      "number": 1,
      "paragraphs": [
        {
          "id": "grid_offer:p1:¶1",
          "heading": "Offer details",
          "text": "Offer reference: FDN/CO/2024/0917"
        },
        {
          "id": "grid_offer:p1:¶2",
          "heading": "Offer details",
          "text": "This Connection Offer is made by Fenland Distribution Networks plc to Brackenfield Solar Limited."
        },
        {
          "id": "grid_offer:p1:¶3",
          "heading": "1. Acceptance",
          "text": "This offer may be accepted by signing and returning it within 90 days of its date of issue, 3 February 2025."
        },
        {
          "id": "grid_offer:p1:¶4",
          "heading": "2. Site",
          "text": "The Connection is for the generation and storage facility at Bracken Farm, Wickham."
        }
      ]
    },
    {
      "number": 2,
      "paragraphs": [
        {
          "id": "grid_offer:p2:¶1",
          "heading": "3. Point of Connection",
          "text": "The Point of Connection shall be the 33 kV busbar at Wickham Primary Substation."
        },
        {
          "id": "grid_offer:p2:¶2",
          "heading": "3. Point of Connection",
          "text": "The Customer shall construct the export cable from the Site to the Point of Connection at its own cost."
        },
        {
          "id": "grid_offer:p2:¶3",
          "heading": "4. Connection",
          "text": "The Maximum Export Capacity at the Point of Connection shall be 45 MW. The Connection Date shall be 1 October 2029, subject to completion of Reinforcement Works at Wickham Primary Substation."
        },
        {
          "id": "grid_offer:p2:¶4",
          "heading": "4. Connection",
          "text": "The Maximum Import Capacity at the Point of Connection shall be 20 MW."
        }
      ]
    },
    {
      "number": 3,
      "paragraphs": [
        {
          "id": "grid_offer:p3:¶1",
          "heading": "5. Charges",
          "text": "The Connection Charge is £4,850,000, payable in the instalments set out in Schedule 2."
        },
        {
          "id": "grid_offer:p3:¶2",
          "heading": "6. Execution",
          "text": "Accepted for and on behalf of Brackenfield Solar Limited on 28 March 2025."
        }
      ]
    }
  ],
