# true (default): read design fixtures and keep review/eval state in memory.
# false: call the FastAPI backend at /api (proxied to localhost:8000 in dev).
VITE_USE_FIXTURES=true
# Dev server only: where /api is proxied when fixtures are off (default http://localhost:8000).
# Set it in the shell, not here: LENS_API_URL=http://localhost:8001 npm run dev
